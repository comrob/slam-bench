# In docker image: /config/override.yaml
# This is an example of an override parameters file for SLAM.
# ROS2 parameter format (YAML).
#
# Example LIORF parameter overrides:
#
# liorf_imuPreintegration:
#   ros__parameters:
#     pointCloudTopic: "/ouster/points"
#     imuTopic: "/ouster/imu"
#     lidarFrame: "os_sensor"
#     extrinsicRot: [1, 0, 0,
#                    0, 1, 0,
#                    0, 0, 1]
#
# liorf_mapOptmization:
#   ros__parameters:
#     gpsTopic: "/none"